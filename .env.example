# Copier en .env.local (site) ou exporter avant les scripts.
# Chaîne de connexion PostgreSQL. Avec Supabase : Project Settings > Database > Connection string (mode Transaction).
DATABASE_URL=postgres://veille:veille@localhost:5432/veille_dev

# Clé de l'API Anthropic, pour déduire le profil de veille des entreprises sans historique public.
# Sans clé, l'inscription marche quand même : le profil est tiré de l'activité déclarée à l'Insee.
ANTHROPIC_API_KEY=
