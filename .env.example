# Copier en .env.local (site) ou exporter avant les scripts.
# Chaîne de connexion PostgreSQL. Avec Supabase : Project Settings > Database > Connection string (mode Transaction).
DATABASE_URL=postgres://veille:veille@localhost:5432/veille_dev

# Clé de l'API Anthropic, pour déduire le profil de veille des entreprises sans historique public.
# Sans clé, l'inscription marche quand même : le profil est tiré de l'activité déclarée à l'Insee.
ANTHROPIC_API_KEY=

# Envoi des courriels d'alerte (Brevo) et adresse publique du site, pour les liens des courriels.
BREVO_API_KEY=
SITE_URL=http://localhost:3000
COURRIEL_ADRESSE=alertes@exemple.fr

# Paiement (Stripe). STRIPE_PRIX est l'identifiant du tarif mensuel (price_…), pas celui du produit.
STRIPE_SECRET_KEY=
STRIPE_PRIX=
STRIPE_WEBHOOK_SECRET=

# Identité de l'éditeur, reprise dans les mentions légales et les conditions.
EDITEUR_RAISON_SOCIALE=
EDITEUR_FORME=
EDITEUR_SIREN=
EDITEUR_ADRESSE=
EDITEUR_DIRECTEUR=
EDITEUR_TVA=
COURRIEL_CONTACT=
